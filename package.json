{
  "name": "helium-new-tab",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.js",
    "build": "bun scripts/build.js",
    "bangs:refresh": "bun scripts/refresh-bangs.js",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun test && bun run build",
    "test": "bun test",
    "prepare": "husky",
    "package": "bun run build && bun scripts/package.js"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tlds": "1.261.0"
  },
  "packageManager": "bun@1.4.2"
}
