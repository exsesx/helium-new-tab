{
  "manifest_version": 3,
  "name": "Helium New Tab",
  "minimum_chrome_version": "123",
  "description": "A lightweight New Tab page for Helium with search, a clock, and local customization.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["search"],
  "optional_permissions": ["favicon"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "assets/extension-icon-16.png",
    "32": "assets/extension-icon-32.png",
    "48": "assets/extension-icon-48.png",
    "96": "assets/extension-icon-96.png",
    "128": "assets/extension-icon-128.png",
    "256": "assets/extension-icon-256.png"
  }
}
